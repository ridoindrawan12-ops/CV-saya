<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ridho Indrawan | Personal Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --blue: #00e5ff;
    --purple: #8b5cf6;
    --bg: #080b14;
    --card: #111827;
    --text: #f8fafc;
    --muted: #94a3b8;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

body::before {
    content: "";
    position: fixed;
    width: 500px;
    height: 500px;
    background: var(--purple);
    filter: blur(180px);
    opacity: .16;
    top: -180px;
    right: -150px;
    z-index: -1;
}

body::after {
    content: "";
    position: fixed;
    width: 400px;
    height: 400px;
    background: var(--blue);
    filter: blur(170px);
    opacity: .12;
    bottom: -150px;
    left: -100px;
    z-index: -1;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(8,11,20,.85);
    backdrop-filter: blur(15px);
    z-index: 100;
    border-bottom: 1px solid #ffffff12;
}

.logo {
    font-family: 'Orbitron';
    font-size: 19px;
    color: var(--blue);
    letter-spacing: 2px;
}

nav a {
    color: var(--text);
    text-decoration: none;
    margin-left: 25px;
    font-size: 13px;
    transition: .3s;
}

nav a:hover {
    color: var(--blue);
}

section {
    padding: 110px 9%;
}

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.hero-text {
    max-width: 650px;
}

.tag {
    display: inline-block;
    padding: 9px 18px;
    border: 1px solid #00e5ff55;
    border-radius: 30px;
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.15;
    font-weight: 800;
}

.hero h1 span {
    background: linear-gradient(90deg,var(--blue),var(--purple));
    -webkit-background-clip: text;
    color: transparent;
}

.hero p {
    margin-top: 25px;
    color: var(--muted);
    line-height: 1.9;
    font-size: 15px;
}

.typing {
    color: var(--blue);
    font-weight: 600;
    min-height: 28px;
    margin-top: 15px;
}

.btn {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 27px;
    border-radius: 8px;
    background: linear-gradient(90deg,var(--blue),var(--purple));
    color: #080b14;
    font-weight: 700;
    text-decoration: none;
    transition: .3s;
}

.btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 25px #00e5ff55;
}

.profile {
    width: 300px;
    height: 370px;
    border-radius: 25px;
    border: 2px solid #00e5ff66;
    background: linear-gradient(145deg,#172337,#10101c);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 0 50px #00e5ff22;
    flex-shrink: 0;
}

.profile .avatar {
    font-size: 110px;
}

.profile::after {
    content: "RIDHO INDRAWAN";
    position: absolute;
    bottom: 22px;
    font-family: 'Orbitron';
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 3px;
}

.section-title {
    text-align: center;
    margin-bottom: 55px;
}

.section-title h2 {
    font-size: 35px;
    font-family: 'Orbitron';
}

.section-title span {
    color: var(--blue);
}

.section-title p {
    color: var(--muted);
    margin-top: 12px;
}

.about-card {
    max-width: 850px;
    margin: auto;
    padding: 40px;
    border-radius: 20px;
    background: linear-gradient(145deg,#151d2e,#0d1220);
    border: 1px solid #ffffff12;
    line-height: 2;
    color: var(--muted);
}

.about-card strong {
    color: var(--blue);
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 20px;
    max-width: 850px;
    margin: 30px auto 0;
}

.info-card {
    padding: 25px;
    border-radius: 15px;
    background: var(--card);
    border: 1px solid #ffffff12;
    transition: .3s;
}

.info-card:hover {
    transform: translateY(-7px);
    border-color: var(--blue);
}

.info-card small {
    color: var(--blue);
    letter-spacing: 1px;
}

.info-card h3 {
    margin-top: 10px;
    font-size: 17px;
}

.info-card p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 5px;
}

.quote {
    text-align: center;
    max-width: 750px;
    margin: auto;
    padding: 50px 30px;
    border: 1px solid #00e5ff44;
    border-radius: 20px;
    background: #101827;
}

.quote h2 {
    font-family: 'Orbitron';
    color: var(--blue);
    font-size: 24px;
    margin-bottom: 20px;
}

.quote p {
    color: var(--muted);
    line-height: 1.9;
}

footer {
    text-align: center;
    padding: 30px;
    border-top: 1px solid #ffffff15;
    color: var(--muted);
    font-size: 12px;
}

footer span {
    color: var(--blue);
}

.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: .8s;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

@media(max-width:800px) {
    nav {
        padding: 18px 5%;
    }

    nav a {
        margin-left: 10px;
        font-size: 11px;
    }

    .hero {
        flex-direction: column-reverse;
        justify-content: center;
        text-align: center;
        padding-top: 130px;
    }

    .profile {
        width: 230px;
        height: 270px;
    }

    .profile .avatar {
        font-size: 80px;
    }

    section {
        padding: 90px 6%;
    }
}

@media(max-width:480px) {
    .logo {
        font-size: 14px;
    }

    nav a {
        margin-left: 8px;
        font-size: 10px;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .about-card {
        padding: 25px;
    }

    .section-title h2 {
        font-size: 25px;
    }
}
</style>
</head>

<body>

